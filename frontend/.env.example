# This is an example .env file
# The actual .env file is generated automatically by scripts/setEnv.js

# Development server configuration
HOST=0.0.0.0          # Binds to all network interfaces
PORT=3000             # Frontend port
DANGEROUSLY_DISABLE_HOST_CHECK=true  # Required for external access

# API configuration (these will be set automatically with correct IP)
REACT_APP_API_URL=http://<auto-detected-ip>:3001/api
REACT_APP_SERVER_URL=http://<auto-detected-ip>:3001
REACT_APP_WS_URL=ws://<auto-detected-ip>:3001 